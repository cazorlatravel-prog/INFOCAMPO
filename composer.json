{
    "name": "infocampo/saas",
    "description": "SaaS de inspección de infraestructuras con cámara, GPS y reportes PDF",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^2.0",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "phpoffice/phpspreadsheet": "^2.0 || ^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Infocampo\\": "includes/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "platform": {
            "php": "8.2.29"
        }
    }
}
