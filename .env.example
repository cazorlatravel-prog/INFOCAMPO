# INFOCAMPO SaaS - Variables de entorno
# Copiar a .env y rellenar con valores reales

DB_HOST=localhost
DB_NAME=infocampo_saas
DB_USER=root
DB_PASS=
# También se acepta DB_PASSWORD en lugar de DB_PASS

# ImageKit.io (servicio principal de imagenes)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# Cloudinary (legacy — solo si no se usa ImageKit)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

APP_URL=http://localhost
