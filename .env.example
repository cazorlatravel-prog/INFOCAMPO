# FotoGPS - Variables de entorno
# Copiar a .env y rellenar con valores reales

# Motor de BD: mysql (por defecto) o pgsql (Supabase)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=infocampo_saas
DB_USER=root
DB_PASS=
# También se acepta DB_PASSWORD en lugar de DB_PASS

# --- Ejemplo para Supabase (PostgreSQL) ---
# DB_DRIVER=pgsql
# DB_HOST=db.XXXXXXX.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=tu_contraseña_supabase

# ImageKit.io (servicio principal de imagenes)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# Cloudinary (legacy — solo si no se usa ImageKit)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

APP_URL=http://localhost
